// @see - https://www.electron.build/configuration/configuration
{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "dev.leadcut.editor",
  "electronUpdaterCompatibility": ">=2.16",
  "asar": true,
  "asarUnpack": [
    "node_modules/ffmpeg-static/**",
    "node_modules/ffprobe-static/**",
    "node_modules/uiohook-napi/**",
    "electron/native/bin/**",
    "electron/native/nvidia-cuda-compositor/run-mp4-pipeline.mjs"
  ],
  "productName": "LeadCut",
  "protocols": [],
  "npmRebuild": true,
  "buildDependenciesFromSource": true,
  "compression": "maximum",
  "afterPack": "./scripts/prepare-packaged-resources.cjs",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist",
    "!dist/wallpapers/**",
    "dist-electron",
    "electron/native/nvidia-cuda-compositor/run-mp4-pipeline.mjs",
    "!electron/native/bin/**/whisper-bench*",
    "!electron/native/bin/**/whisper-quantize*",
    "!electron/native/bin/**/whisper-server*",
    "!electron/native/bin/**/whisper-vad-speech-segments*",
    "!node_modules/ffprobe-static/bin/win32/ia32/**",
    "!electron/native/**/build/**",
    "!*.png",
    "!preview*.png",
    "!*.md",
    "!README.md",
    "!CONTRIBUTING.md",
    "!LICENSE"
  ],
  "extraResources": [
    { "from": "README.md", "to": "使用说明.md" },
    { "from": "LICENSE.md", "to": "LICENSE.md" },
    { "from": "THIRD_PARTY_NOTICES.md", "to": "THIRD_PARTY_NOTICES.md" },
    { "from": ".tmp/leadcut-mcp-bundle/index.cjs", "to": "leadcut-mcp/dist/index.cjs" },
    { "from": "services/leadcut-mcp/scripts/transcribe.py", "to": "leadcut-mcp/scripts/transcribe.py" },
    {
      "from": "public/wallpapers",
      "to": "assets/wallpapers"
    }
  ],
  "publish": [{ "provider": "github", "owner": "AzenYes", "repo": "LeadCut" }],

  "mac": {
    "files": [
      "dist/**",
      "!dist/wallpapers/**",
      "dist-electron/**",
      "electron/native/bin/darwin-${arch}/**",
      "electron/native/nvidia-cuda-compositor/run-mp4-pipeline.mjs",
      "!node_modules/ffprobe-static/bin/linux/**",
      "!node_modules/ffprobe-static/bin/win32/**"
    ],
    "hardenedRuntime": true,
    "entitlements": "build/entitlements.mac.plist",
    "entitlementsInherit": "build/entitlements.mac.inherit.plist",
    "target": [
      {
        "target": "dmg",
        "arch": ["x64", "arm64"]
      },
      {
        "target": "zip",
        "arch": ["x64", "arm64"]
      }
    ],
    "icon": "icons/icons/mac/icon.icns",
    "artifactName": "${productName}-${arch}.${ext}",
    "extendInfo": {
      "NSAudioCaptureUsageDescription": "LeadCut needs audio capture permission to record system audio.",
      "NSCameraUsageDescription": "LeadCut needs camera access to record webcam video.",
      "NSMicrophoneUsageDescription": "LeadCut needs microphone access to record voice audio.",
      "NSCameraUseContinuityCameraDeviceType": true,
      "com.apple.security.device.audio-input": true,
      "CFBundleDocumentTypes": [
        {
          "CFBundleTypeName": "LeadCut Project",
          "CFBundleTypeRole": "Editor",
          "CFBundleTypeExtensions": ["leadcut"],
          "CFBundleTypeIconFile": "icon.icns",
          "LSHandlerRank": "Owner",
          "LSItemContentTypes": ["dev.leadcut.editor.project"]
        }
      ],
      "UTExportedTypeDeclarations": [
        {
          "UTTypeIdentifier": "dev.leadcut.editor.project",
          "UTTypeDescription": "LeadCut Project",
          "UTTypeConformsTo": ["public.json"],
          "UTTypeTagSpecification": {
            "public.filename-extension": ["leadcut"],
            "public.mime-type": "application/x-leadcut-project"
          }
        }
      ]
    }
  },
  "linux": {
    "files": [
      "electron/native/bin/linux-${arch}/**",
      "!node_modules/ffprobe-static/bin/darwin/**",
      "!node_modules/ffprobe-static/bin/linux/ia32/**",
      "!node_modules/ffprobe-static/bin/win32/**"
    ],
    "target": [
      "AppImage"
    ],
    "icon": "icons/icons/png",
    "artifactName": "${productName}-linux-x64.${ext}",
    "category": "AudioVideo"
  },
  "win": {
    "electronLanguages": [
      "de", "en-GB", "en-US", "es", "es-419", "fr", "it", "ko", "nl", "pt-BR", "ru", "zh-CN", "zh-TW"
    ],
    "files": [
      "dist/**",
      "!dist/wallpapers/**",
      "dist-electron/**",
      "electron/native/nvidia-cuda-compositor/run-mp4-pipeline.mjs",
      "!node_modules/ffprobe-static/bin/darwin/**",
      "!node_modules/ffprobe-static/bin/linux/**",
      "!node_modules/ffprobe-static/bin/win32/ia32/**"
    ],
    "extraResources": [
      {
        "from": "electron/native/bin/win32-${arch}",
        "to": "app.asar.unpacked/electron/native/bin/win32-${arch}",
        "filter": [
          "cursor-monitor.exe",
          "ggml-base.dll",
          "ggml-cpu.dll",
          "ggml.dll",
          "helpers-manifest.json",
          "leadcut-gpu-export.exe",
          "leadcut-local-font-catalog.exe",
          "recordly-nvidia-cuda-compositor.exe",
          "wgc-capture.exe",
          "whisper-cli.exe",
          "whisper-runtime.json",
          "whisper.dll"
        ]
      },
      {
        "from": "electron/native/bin/win32-${arch}/LeadCutThumbnail.dll",
        "to": "LeadCutThumbnail.dll"
      }
    ],
    "fileAssociations": [{
      "ext": "leadcut",
      "name": "LeadCut.Project",
      "description": "LeadCut 工程",
      "icon": "public/app-icons/leadcut-project.ico",
      "role": "Editor"
    }],
    "target": [
      "nsis"
    ],
    "icon": "public/app-icons/leadcut.ico",
    "executableName": "LeadCut",
    "artifactName": "${productName}-${version}-windows-${arch}.${ext}"
  },
  "nsis": {
    "include": "build/installer.nsh",
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "LeadCut"
  }
}
